	(text "PHYRSTB is a 3.3 V input: U902 74LVC1G07 (1V8 supply) open drain, R932 10k to 3V3, C901 filter.\nR933 holds eth_rst_n low until the FPGA drives it (PHY in reset during configuration)."
		(exclude_from_sim no)
		(at 83.82 177.8 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "46da9ba3-8c00-5fd0-a02e-b651786a4d81")
	)
	(text "DVDD_RG: RGMII pad LDO output (1.8 V), caps only"
		(exclude_from_sim no)
		(at 259.08 210.82 0)
		(effects
