	(text "ADC chain: mux U1301 -> buffer U1302 -> ADS7056 U1303 (front end as on the Agilex 3 card, 2.5 MSPS design).\nMux: X0 GND (zero ref), X1 VCORE, X2 1V8, X3 3V3/2, X4 isoada2, X5 1V1, X6 isoada3, X7 isoada1.\nFull scale 0..3.3 V (AVDD = reference). The FPGA maps the channel numbers."
		(exclude_from_sim no)
		(at 17.78 17.78 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "eb32645a-330c-511f-b2c7-1891ee08d488")
	)
