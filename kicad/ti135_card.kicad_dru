(version 1)
# Ti135 control card DRC rules: the Agilex 5 card's LPDDR4 / JLCPCB rules (tools/board_setup.py),
# U7 -> U501 (Ti135N484, 0.8 mm pitch, no sub-0.09 mm exception), U12 -> U801 (LPDDR4).

# ===================================================================================================
# LPDDR4 rules (net classes lpddr_dq, lpddr_ca, lpddr_diff).  KiCad applies the LAST matching rule,
# so the general rules come first and the BGA-courtyard exceptions (U7 Agilex, U12 LPDDR4) after them.
# intersectsCourtyard() also catches segments that cross the courtyard edge (insideCourtyard() would not).
# Targets: Altera PCB Design Guidelines 821801, 6.3.2.2 (Agilex 5 E-Series Group B), Tables 8-10:
#   main segment 40 ohm stripline / 45 ohm microstrip; break-out/break-in 50 ohm allowed; no differential
#   target for CLK/DQS ("keep traces closely coupled", 4 mil in-pair spacing); spacing 2h within a group,
#   3h between groups (CMD/CLK to DQ/DQS, nibble to nibble, serpentines, RESET); P/N skew < 1 ps.
# Stack-up JLC08161H-3313 (field solve from the Ti135 session): 40 ohm = 0.18 mm on In2/In5, 50 ohm =
#   0.15 mm on F/B, 40 ohm = 0.25 mm on F/B -> 45 ohm ~ 0.20 mm on F/B (interpolated, verify).  h ~ 0.1 mm
#   on F.Cu/In2/In5, so 2h = 0.2 mm and 3h = 0.3 mm.  Route LPDDR4 on In2 (over In1 GND) first, In5 only
#   inside one In6 pour, edge escapes on F.Cu; not on In3/In6 (see LPDDR4_SWIZZLE_PLAN.md).
# JLCPCB minimum trace/space is 0.09 mm; the 0.075 mm clearance used between the 0.4 mm U7 pads is below
# that - see the note at the end.
# ===================================================================================================

# ---- trace width: 0.1 mm everywhere (2026-10-30) --------------------------------------------------
# The hand routing runs at 0.1 mm: 52.6 ohm on In2/In5, 60.4 ohm on F/B; pairs 0.10/0.20 inner 97 ohm (field solve,
# sim/lpddr4_si/README.md). That is off Efinix's 40/80 ohm and >= 5 mil, but the IBIS check of the routed bytes passes
# at 2800/3200 MT/s (typ). Keep F/B runs short (narrow outer costs more margin than inner). CA/CK and the min/max
# corners are to be simulated after delay matching.
(rule "lpddr_width"
	(condition "A.hasNetclass('lpddr_dq') || A.hasNetclass('lpddr_ca') || A.hasNetclass('lpddr_diff')")
	(constraint track_width (min 0.09mm) (opt 0.1mm) (max 0.11mm)))
(rule "lpddr_diff_gap"
	(condition "A.hasNetclass('lpddr_diff')")
	(constraint diff_pair_gap (min 0.1mm) (opt 0.2mm) (max 0.25mm)))

# ---- pair integrity (whole net, all layers) --------------------------------------------------------
# P/N skew < 1 ps (Table 10), and the total length the two halves may run apart: escape through the U7
# ball field (~6 mm), the U12 escape through its 0.65 mm channels (~8 mm) and the pad entries.
# CK is left out: its P and N each branch to both channels, and KiCad's skew compares whole nets (the two branches
# differ ~1.3 ps). CK P/N is held by its per-net path rules instead (lpddr_delay_ck_P/N, +-0.4 ps -> <= 0.8 ps).
(rule "lpddr_pair_skew"
	(condition "A.hasNetclass('lpddr_diff') && A.NetName != '/08 lpddr4/ddr_ck_P' && A.NetName != '/08 lpddr4/ddr_ck_N'")
	(constraint skew (max 1ps) (within_diff_pairs)))
(rule "lpddr_pair_uncoupled"
	(condition "A.hasNetclass('lpddr_diff')")
	(constraint diff_pair_uncoupled (max 12mm)))

# ---- crosstalk spacing outside the BGAs (warnings) -------------------------------------------------
# 2h within a group, 3h between groups.  Byte-to-byte (nibble) 3h is not expressible per byte with the
# current net classes: keep 0.3 mm between bytes by hand.
(rule "lpddr_xtalk_spacing"
	(severity warning)
	(condition "A.Type == 'Track' && B.Type == 'Track' && (A.hasNetclass('lpddr_dq') || A.hasNetclass('lpddr_ca') || A.hasNetclass('lpddr_diff')) && (B.hasNetclass('lpddr_dq') || B.hasNetclass('lpddr_ca') || B.hasNetclass('lpddr_diff')) && A.NetName != B.NetName && !A.inDiffPair('*') && !(A.intersectsCourtyard('U501') || A.intersectsCourtyard('U801'))")
	(constraint clearance (min 0.2mm)))
(rule "lpddr_xtalk_group"
	(severity warning)
	(condition "A.Type == 'Track' && B.Type == 'Track' && ((A.hasNetclass('lpddr_ca') && (B.hasNetclass('lpddr_dq') || B.NetName == '/08 lpddr4/ddr_dqs0_P' || B.NetName == '/08 lpddr4/ddr_dqs0_N' || B.NetName == '/08 lpddr4/ddr_dqs1_P' || B.NetName == '/08 lpddr4/ddr_dqs1_N' || B.NetName == '/08 lpddr4/ddr_dqs2_P' || B.NetName == '/08 lpddr4/ddr_dqs2_N' || B.NetName == '/08 lpddr4/ddr_dqs3_P' || B.NetName == '/08 lpddr4/ddr_dqs3_N')) || A.NetName == '/08 lpddr4/ddr_rst_n') && A.NetName != B.NetName && !(A.intersectsCourtyard('U501') || A.intersectsCourtyard('U801'))")
	(constraint clearance (min 0.3mm)))

# ---- LPDDR4 routing layers (LPDDR4_SWIZZLE_PLAN.md "Layer rules") -------------------------------------
# Tracks only on F.Cu, In2, In5 and B.Cu: In1/In4 are GND planes, In3 (~73 ohm, no adjacent plane) and In6
# (power islands) are not for LPDDR4.  Vias are not affected.  "In5 only inside one In6 pour" cannot be
# expressed here (rules can test rule areas, not copper pours): check it by eye.
(rule "lpddr_layers"
	(condition "A.Type == 'Track' && (A.hasNetclass('lpddr_dq') || A.hasNetclass('lpddr_ca') || A.hasNetclass('lpddr_diff')) && (A.Layer == 'In1.Cu' || A.Layer == 'In3.Cu' || A.Layer == 'In4.Cu' || A.Layer == 'In6.Cu')")
	(constraint disallow track))

# ---- inside the BGA courtyards: neck-down and single-channel escape ---------------------------------
# One 0.1 mm trace per channel between the balls.  A pair may split into two channels here, so the
# gap has no real upper limit (5 mm; without a max KiCad applies 0.15 mm); it is counted as uncoupled
# length by the rule above. The CA/CK T-branches under U12 rely on this.
(rule "lpddr_bga_neckdown"
	(condition "(A.hasNetclass('lpddr_dq') || A.hasNetclass('lpddr_ca') || A.hasNetclass('lpddr_diff')) && (A.intersectsCourtyard('U501') || A.intersectsCourtyard('U801'))")
	(constraint track_width (min 0.09mm) (opt 0.1mm))
	(constraint diff_pair_gap (min 0.1mm) (opt 0.2mm) (max 5mm)))

# Clearance between LPDDR tracks and the U7 pads / via-in-pad vias: the 0.4 mm pads on 0.65 mm pitch
# leave 0.25 mm, i.e. 0.1 mm trace + 2 x 0.075 mm.  This matches the 0.075 mm pad overrides already on
# the footprint and the board minimum clearance, but it is BELOW JLCPCB's 0.09 mm capability.  To be
# within spec, reduce the U7 pads to 0.35 mm (0.3 mm channel -> 0.1 mm trace + 2 x 0.1 mm) and raise
# this rule and the board minimum to 0.09 mm.
(rule "lpddr_bga_clearance_u801"
	(condition "(A.hasNetclass('lpddr_dq') || A.hasNetclass('lpddr_ca') || A.hasNetclass('lpddr_diff')) && A.Type == 'Track' && (B.Type == 'Pad' || B.Type == 'Via') && A.intersectsCourtyard('U801')")
	(constraint clearance (min 0.1mm)))

# ===================================================================================================
# JLCPCB multilayer capabilities (jlcpcb.com/capabilities/pcb-capabilities, checked 2026-10-13).
# Board setup constraints carry the rest: clearance/track 0.09, via 0.25/0.15 (annular 0.05, 0.075
# preferred - the 0.3/0.15 vias used here), via hole-to-hole 0.2, silk 1.0 mm / 0.15 mm.
# Via-in-pad on U7 relies on JLCPCB epoxy filled & capped vias (default for 6+ layers; select it
# when ordering).
#
# Hole clearance is set to 0.175 mm (= 0.075 mm via ring + 0.1 mm copper clearance). JLCPCB lists
# "via hole to track 0.2 mm" without saying whether it is measured from the drill or the ring; at
# 0.2 mm about 200 existing track/via spots would fail. Confirm with the JLCPCB DFM check on the
# Gerbers before raising it.
# ===================================================================================================
(rule "jlc_pth_annular"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
	(constraint annular_width (min 0.15mm)))
(rule "jlc_pad_hole_to_hole"
	(condition "A.Type == 'Pad' && B.Type == 'Pad' && A.Pad_Type == 'Through-hole' && B.Pad_Type == 'Through-hole'")
	(constraint hole_to_hole (min 0.45mm)))
(rule "jlc_pth_to_track"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole' && B.Type != 'Pad'")
	(constraint hole_clearance (min 0.28mm)))


# J3 corner pins 37/38: the hole positions come from the Ti60 card / baseboard (MECHANICAL.md) and sit
# 0.89 mm from the top edge, so their pads are 0.39 mm from it. JLC's routed-edge minimum is 0.3 mm.
(rule "j3_baseboard_edge"
	(condition "A.memberOfFootprint('J3')")
	(constraint edge_clearance (min 0.3mm)))

# ---- CKE0 width exception (2026-10-30) -------------------------------------------------------------
# CKE has no ODT (unterminated T to both channels): 0.12 mm on In2 (48.6 ohm) is a closer match to the 34-40 ohm FPGA
# driver than 0.1 mm (52.6 ohm). IBIS (sim/lpddr4_si run_si.py --cke, typ/min): lower over/undershoot at 0.12 at
# both rates; at 3200 typ the 0.1 mm die peak exceeds VDDQ + 0.3 V, 0.12 does not. The B.Cu breakout/branches stay
# 0.25 mm. Placed after the BGA neck-down rule so it wins under U801 too.
(rule "lpddr_cke_width"
	(condition "A.NetName == '/08 lpddr4/ddr_cke0'")
	(constraint track_width (min 0.09mm) (opt 0.12mm) (max 0.26mm)))

# ---- BEGIN generated delay targets (tools/ddr/delay_rules.sh; do not edit by hand) ----
(rule "lpddr_delay_ca0"
	(condition "A.NetName == '/08 lpddr4/ddr_ca0'")
	(constraint length (min 304.0ps) (opt 306.5ps) (max 334.9ps)))
(rule "lpddr_delay_ca1"
	(condition "A.NetName == '/08 lpddr4/ddr_ca1'")
	(constraint length (min 304.0ps) (opt 306.5ps) (max 331.7ps)))
(rule "lpddr_delay_ca2"
	(condition "A.NetName == '/08 lpddr4/ddr_ca2'")
	(constraint length (min 304.0ps) (opt 306.5ps) (max 335.4ps)))
(rule "lpddr_delay_ca3"
	(condition "A.NetName == '/08 lpddr4/ddr_ca3'")
	(constraint length (min 304.0ps) (opt 306.5ps) (max 335.0ps)))
(rule "lpddr_delay_ca4"
	(condition "A.NetName == '/08 lpddr4/ddr_ca4'")
	(constraint length (min 304.0ps) (opt 306.5ps) (max 335.6ps)))
(rule "lpddr_delay_ca5"
	(condition "A.NetName == '/08 lpddr4/ddr_ca5'")
	(constraint length (min 304.0ps) (opt 306.5ps) (max 330.8ps)))
(rule "lpddr_delay_cke0"
	(condition "A.NetName == '/08 lpddr4/ddr_cke0'")
	(constraint length (min 304.0ps) (opt 306.5ps) (max 334.1ps)))
(rule "lpddr_delay_cs0_n"
	(condition "A.NetName == '/08 lpddr4/ddr_cs0_n'")
	(constraint length (min 304.0ps) (opt 306.5ps) (max 309.0ps)))
(rule "lpddr_delay_cs2_n"
	(condition "A.NetName == '/08 lpddr4/ddr_cs2_n'")
	(constraint length (min 304.0ps) (opt 306.5ps) (max 309.0ps)))
(rule "lpddr_delay_ck_P"
	(condition "A.NetName == '/08 lpddr4/ddr_ck_P'")
	(constraint length (min 306.1ps) (opt 306.5ps) (max 330.3ps)))
(rule "lpddr_delay_ck_N"
	(condition "A.NetName == '/08 lpddr4/ddr_ck_N'")
	(constraint length (min 306.1ps) (opt 306.5ps) (max 331.6ps)))
(rule "lpddr_delay_byte0_dqs"
	(condition "A.NetName == '/08 lpddr4/ddr_dqs0_P' || A.NetName == '/08 lpddr4/ddr_dqs0_N'")
	(constraint length (min 274.0ps) (opt 274.5ps) (max 275.0ps)))
(rule "lpddr_delay_byte0_dq"
	(condition "A.NetName == '/08 lpddr4/ddr_dq0' || A.NetName == '/08 lpddr4/ddr_dq1' || A.NetName == '/08 lpddr4/ddr_dq2' || A.NetName == '/08 lpddr4/ddr_dq3' || A.NetName == '/08 lpddr4/ddr_dq4' || A.NetName == '/08 lpddr4/ddr_dq5' || A.NetName == '/08 lpddr4/ddr_dq6' || A.NetName == '/08 lpddr4/ddr_dq7' || A.NetName == '/08 lpddr4/ddr_dm0'")
	(constraint length (min 279.5ps) (opt 284.5ps) (max 289.5ps)))
(rule "lpddr_delay_byte1_dqs"
	(condition "A.NetName == '/08 lpddr4/ddr_dqs1_P' || A.NetName == '/08 lpddr4/ddr_dqs1_N'")
	(constraint length (min 180.9ps) (opt 181.4ps) (max 181.9ps)))
(rule "lpddr_delay_byte1_dq"
	(condition "A.NetName == '/08 lpddr4/ddr_dq8' || A.NetName == '/08 lpddr4/ddr_dq9' || A.NetName == '/08 lpddr4/ddr_dq10' || A.NetName == '/08 lpddr4/ddr_dq11' || A.NetName == '/08 lpddr4/ddr_dq12' || A.NetName == '/08 lpddr4/ddr_dq13' || A.NetName == '/08 lpddr4/ddr_dq14' || A.NetName == '/08 lpddr4/ddr_dq15' || A.NetName == '/08 lpddr4/ddr_dm1'")
	(constraint length (min 186.4ps) (opt 191.4ps) (max 196.4ps)))
(rule "lpddr_delay_byte2_dqs"
	(condition "A.NetName == '/08 lpddr4/ddr_dqs2_P' || A.NetName == '/08 lpddr4/ddr_dqs2_N'")
	(constraint length (min 215.2ps) (opt 215.7ps) (max 216.2ps)))
(rule "lpddr_delay_byte2_dq"
	(condition "A.NetName == '/08 lpddr4/ddr_dq16' || A.NetName == '/08 lpddr4/ddr_dq17' || A.NetName == '/08 lpddr4/ddr_dq18' || A.NetName == '/08 lpddr4/ddr_dq19' || A.NetName == '/08 lpddr4/ddr_dq20' || A.NetName == '/08 lpddr4/ddr_dq21' || A.NetName == '/08 lpddr4/ddr_dq22' || A.NetName == '/08 lpddr4/ddr_dq23' || A.NetName == '/08 lpddr4/ddr_dm2'")
	(constraint length (min 220.7ps) (opt 225.7ps) (max 230.7ps)))
(rule "lpddr_delay_byte3_dqs"
	(condition "A.NetName == '/08 lpddr4/ddr_dqs3_P' || A.NetName == '/08 lpddr4/ddr_dqs3_N'")
	(constraint length (min 205.6ps) (opt 206.1ps) (max 206.6ps)))
(rule "lpddr_delay_byte3_dq"
	(condition "A.NetName == '/08 lpddr4/ddr_dq24' || A.NetName == '/08 lpddr4/ddr_dq25' || A.NetName == '/08 lpddr4/ddr_dq26' || A.NetName == '/08 lpddr4/ddr_dq27' || A.NetName == '/08 lpddr4/ddr_dq28' || A.NetName == '/08 lpddr4/ddr_dq29' || A.NetName == '/08 lpddr4/ddr_dq30' || A.NetName == '/08 lpddr4/ddr_dq31' || A.NetName == '/08 lpddr4/ddr_dm3'")
	(constraint length (min 211.1ps) (opt 216.1ps) (max 221.1ps)))
# ---- END generated delay targets ----
